# Keep directory structure
!data/.gitkeep
!data/models/.gitkeep
!data/vectors/.gitkeep
!data/cache/.gitkeep
!data/logs/.gitkeep
!data/workflows/.gitkeep

# Workflow run data (persisted locally)
data/workflows/*/

# A2A task state (persisted locally — same pattern as workflows)
data/a2a/

# Provenance grounding chains + persisted conversations (gap-closure track)
data/provenance/
data/conversations/

# Brainstorm session files
.superpowers/

# ── Runtime user data — never commit ────────────────────────────────
# API key hashes and metadata (managed via /api/keys endpoints)
data/config/api_keys.yaml
# First-run master key sentinel (raw value, mode 0600)
data/config/first-run-key.txt
# User-pinned memories and session summaries
data/memory/sessions/
data/memory/facts.yaml
data/memory/index.yaml
# Per-conversation sandboxes (wiped when session closes)
data/sandboxes/
# RAG document storage and ChromaDB
data/rag/
# Exported session markdown
data/exports/
# Graph cache
data/graph/
# Playwright artifacts
.playwright-mcp/

# ── Secrets (narrow — DO NOT add blanket *.pem/*.key globs) ─────────
# Narrow suffix-scoped patterns prevent real private material from
# landing in git while still allowing any bona-fide public keys or
# certificates to be committed by their natural filenames.
**/*_privkey.pem
**/*-private.pem
**/*.private.key
**/id_rsa
**/id_ed25519
*secret*.yaml
*secret*.yml
*secret*.json
*credentials*.yaml
*credentials*.yml
*credentials*.json

# ── Build artifacts ─────────────────────────────────────────────────
# macOS DMG output (dist/ already ignored; this catches stray copies)
*.dmg
*.icns.backup
data/logs/*.jsonl

# Claude Code user-specific overrides
.claude/settings.local.json

# Desktop app build artifacts (from magical-payne)
desktop/dist/
desktop/build/
*.app

# ── Claude Code worktrees (project-local isolation) ─────────────────
.claude/worktrees/
.worktrees/
.superpowers/

# ── Playwright artifacts (PNG screenshots + WebM videos + traces) ───
# Per-run, intentionally not committed; reproducible by running
# scripts/run-playwright.sh or scripts/record-demos.sh.
playwright-results/

# ── Runtime data captured locally (feedback + per-project tasks) ────
data/feedback/
data/projects/

# ── Private overlay (IP-grade content kept out of the public repo) ──
# The workflow engine, agent service, and plugin loader all scan an
# optional *-private/ directory alongside the public one. Drop methodology-
# heavy YAMLs / markdown / Python here to keep them off GitHub while
# still loadable by the local stack. See docs/PRIVATE_OVERLAY.md.
workflows-private/
agents-private/
plugins-private/
docs/seed-private/
