# Local AI Platform Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Authentication
# ENABLE_API_AUTH defaults to true on a fresh boot. The server auto-provisions
# a master API key on first start and writes the raw value to:
#   data/config/first-run-key.txt   (mode 0600)
# It's also printed to the startup log once. Rotate it via /api/keys when ready.
# Set ENABLE_API_AUTH=false ONLY for trusted, never-network-exposed dev mode.
ENABLE_API_AUTH=true
# Optional: pin a specific key instead of using the auto-provisioned one.
# If set, the auto-provision step is skipped.
API_KEY=
MASTER_API_KEY=

# Rate Limiting (requests per minute, 0 to disable)
RATE_LIMIT_RPM=60

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_THREADS=24
OLLAMA_NUM_CTX=4096

# vLLM inference backend (Linux/NVIDIA performance path; optional).
# When set to a reachable vLLM OpenAI-compatible server, detect_runners()
# registers a vLLM runner alongside Ollama. Empty = Ollama-only (default).
# Launch vLLM out-of-band with scripts/vllm-serve.sh. Comma-separated; the
# first URL is used in Phase 2. See docs/deployment/vllm-backend.md.
ENCLAVE_VLLM_BASE_URLS=
# ENCLAVE_VLLM_API_KEY=             # if vLLM was started with --api-key
# ENCLAVE_VLLM_MAX_CONCURRENT=256   # scheduler dispatch cap for vLLM
# ENCLAVE_PREFERRED_RUNNER=         # ollama|vllm — operator/dev escape hatch
# STRICT_RUNNER_DETECTION=false     # true = fail startup if configured vLLM is down

# Model Configuration
DEFAULT_MODEL=dolphin3:latest
MODELS_DIR=./data/models
MODEL_CACHE_DIR=./data/cache

# Request Handling
MAX_CONCURRENT_REQUESTS=4
# Ollama upstream read-timeout (seconds). 900s covers CPU-only inference
# of long grounded prompts. GPU deployments can drop to 120-180s safely.
REQUEST_TIMEOUT=900
# LLM concurrency cap. On CPU-only hardware, two models fighting for
# prefill bandwidth deliver worse throughput than running serially.
# Default 1 = strict serialization. Raise for GPU deployments.
MAX_CONCURRENT_LLM=1
# How long Ollama holds a loaded GGUF in RAM after its last request.
# Adjacent workflow steps using the same model skip the 30-90s reload tax.
# Go duration string: "10m", "24h", "0" (evict immediately), "-1" (never).
OLLAMA_KEEP_ALIVE=10m
# TTL (seconds) for the model-list cache. 10-step workflow = 1 /api/tags
# call instead of 10. Lower if models are pulled while the engine is live.
MODEL_LIST_TTL=30

# CORS (JSON array or comma-separated origins)
CORS_ORIGINS=["http://localhost:8080", "http://localhost:3000"]

# Vector Database
VECTOR_DB=chroma
VECTOR_DB_PATH=./data/vectors

# Fine-tuning
FINETUNING_OUTPUT_DIR=./finetuning/outputs
FINETUNING_BATCH_SIZE=4
FINETUNING_LEARNING_RATE=2e-5

# Web UI
WEBUI_PORT=8080
WEBUI_HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_DIR=./data/logs

# Profile System (Phase 3)
DEFAULT_PROFILE=default

# Capability marketplace (optional). Point at a remote JSON skills index
# ({"skills":[...]} or a bare [...] list) and the Skills discover view merges
# it in alongside the local catalog + bundled installs (cached 10m, fails soft
# to local-only). Works with any marketplace that publishes JSON.
ENCLAVE_SKILLS_CATALOG_URL=

# RAG / Embeddings (Phase 4)
EMBEDDING_BACKEND=auto
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# ── Error reporting & triage (opt-in, off by default) ───────────────────────
# Master switch. When false (default) the app behaves exactly as before:
# unhandled errors are logged locally and nothing leaves the box.
ENABLE_ERROR_REPORTING=false
# Where reports go: none | github | webhook | sentry  (operator-owned by default)
ERROR_SINK=none
# For ERROR_SINK=github use "owner/repo"; for webhook/sentry use the URL.
ERROR_SINK_URL=
ERROR_SINK_TOKEN=
# Optional vendor phone-home (Phase 3) — off by default, requires disclosure.
ERROR_REPORTING_VENDOR=false
ERROR_VENDOR_URL=
# Local-Ollama enrichment (best-effort; auto-skips if unreachable).
TRIAGE_ENRICH=true
TRIAGE_OLLAMA_URL=http://localhost:11434
TRIAGE_OLLAMA_MODEL=qwen2.5:14b-instruct-q5_K_M
# Redaction floor — prompts/secrets/home-paths are always scrubbed; cannot be disabled.
TRIAGE_REDACT=true
