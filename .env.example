# Local AI Platform Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Authentication (set ENABLE_API_AUTH=true to require API keys)
API_KEY=your-api-key-here
MASTER_API_KEY=your-master-key-for-key-management
ENABLE_API_AUTH=false

# Rate Limiting (requests per minute, 0 to disable)
RATE_LIMIT_RPM=60

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_THREADS=24
OLLAMA_NUM_CTX=4096

# Model Configuration
DEFAULT_MODEL=dolphin3:latest
MODELS_DIR=./data/models
MODEL_CACHE_DIR=./data/cache

# Request Handling
MAX_CONCURRENT_REQUESTS=4
REQUEST_TIMEOUT=300

# CORS (JSON array or comma-separated origins)
CORS_ORIGINS=["http://localhost:8080", "http://localhost:3000"]

# Vector Database
VECTOR_DB=chroma
VECTOR_DB_PATH=./data/vectors

# Fine-tuning
FINETUNING_OUTPUT_DIR=./finetuning/outputs
FINETUNING_BATCH_SIZE=4
FINETUNING_LEARNING_RATE=2e-5

# Web UI
WEBUI_PORT=8080
WEBUI_HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_DIR=./data/logs
