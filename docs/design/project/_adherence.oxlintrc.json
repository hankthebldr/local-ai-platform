{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/console/**",
              "components/core/**",
              "components/dataviz/**",
              "components/workflow/**",
              "ui_kits/console-v2/**",
              "ui_kits/console/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|accent|lg|onDismiss|key|ref|className|style|children)$/]",
        "message": "<ActionChip> doesn't accept that prop. Declared props: icon, accent, lg, onDismiss."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|dot|square|solid|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, dot, square, solid."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|success|warn|danger|info|warm)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'success' | 'warn' | 'danger' | 'info' | 'warm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|loading|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, loading, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|warm|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'warm' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EntityCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|type|status|meta|desc|fits|usedBy|selected|actions|key|ref|className|style|children)$/]",
        "message": "<EntityCard> doesn't accept that prop. Declared props: id, type, status, meta, desc, fits, usedBy, selected, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='EntityCard'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:model|agent|skill|plugin|mcp|context|workflow|run|chat)$/]",
        "message": "<EntityCard> type must be one of 'model' | 'agent' | 'skill' | 'plugin' | 'mcp' | 'context' | 'workflow' | 'run' | 'chat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EntityCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:online|idle|error)$/]",
        "message": "<EntityCard> status must be one of 'online' | 'idle' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FitBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|hint|color|showValue|key|ref|className|style|children)$/]",
        "message": "<FitBar> doesn't accept that prop. Declared props: label, value, hint, color, showValue."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|size|active|bare|disabled|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, label, size, active, bare, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|icon|required|mono|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, icon, required, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='MaturityMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|total|hot|label|key|ref|className|style|children)$/]",
        "message": "<MaturityMeter> doesn't accept that prop. Declared props: value, total, hot, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|sub|percent|color|bar|row|key|ref|className|style|children)$/]",
        "message": "<MetricStat> doesn't accept that prop. Declared props: label, value, sub, percent, color, bar, row."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|headerExtra|ticks|translucent|flush|active|pad|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: children, label, headerExtra, ticks, translucent, flush, active, pad."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoleChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|desc|kind|icon|grip|key|ref|className|style|children)$/]",
        "message": "<RoleChip> doesn't accept that prop. Declared props: title, desc, kind, icon, grip."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoleChip'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:reasoning|coding|fast|general|uncensored|agent|skill|plugin|mcp)$/]",
        "message": "<RoleChip> kind must be one of 'reasoning' | 'coding' | 'fast' | 'general' | 'uncensored' | 'agent' | 'skill' | 'plugin' | 'mcp'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunStatus'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|current|step|total|showBar|key|ref|className|style|children)$/]",
        "message": "<RunStatus> doesn't accept that prop. Declared props: state, current, step, total, showBar."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunStatus'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:running|success|error|queued|idle)$/]",
        "message": "<RunStatus> state must be one of 'running' | 'success' | 'error' | 'queued' | 'idle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeedChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:k|v|tone|ghost|onRemove|key|ref|className|style|children)$/]",
        "message": "<SeedChip> doesn't accept that prop. Declared props: k, v, tone, ghost, onRemove."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeedChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent)$/]",
        "message": "<SeedChip> tone must be one of 'neutral' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkline'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|width|height|color|fill|strokeWidth|dot|max|min|key|ref|className|style|children)$/]",
        "message": "<Sparkline> doesn't accept that prop. Declared props: data, width, height, color, fill, strokeWidth, dot, max, min."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPip'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|live|size|key|ref|className|style|children)$/]",
        "message": "<StatusPip> doesn't accept that prop. Declared props: status, live, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPip'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:online|running|success|warn|danger|error|idle)$/]",
        "message": "<StatusPip> status must be one of 'online' | 'running' | 'success' | 'warn' | 'danger' | 'error' | 'idle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<StatusPip> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|onChange|label|size|disabled|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, defaultChecked, onChange, label, size, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Toggle> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrendStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|delta|deltaGood|data|color|sparkWidth|key|ref|className|style|children)$/]",
        "message": "<TrendStat> doesn't accept that prop. Declared props: label, value, delta, deltaGood, data, color, sparkWidth."
